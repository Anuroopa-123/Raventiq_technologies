# Copy to .env and fill in
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/raventiq
CORS_ORIGINS=http://localhost:4200,https://www.yourdomain.com

# SMTP (Gmail example: enable 2-step verification, then create an "App password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourteam@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM=Raventiq <yourteam@gmail.com>
# Comma-separated: who gets notified when someone fills the contact form
NOTIFY_EMAILS=anukalpana2003@gmail.com

# --- Auth ---
# Random secret that signs login sessions (JWTs). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Set a fixed value here in production -- if it's left blank, a new random one is
# generated on every restart and everybody gets logged out.
JWT_SECRET=

# The OWNER's login (superadmin). Created automatically the first time the API
# starts, if no superadmin exists yet. Change this password after first login.
SUPERADMIN_NAME=Anuroopa & Dinesh
SUPERADMIN_EMAIL=owner@raventiq.com
SUPERADMIN_PASSWORD=choose-a-strong-password

# Google Sign-In (optional -- leave blank to hide the "Sign in with Google" button).
# Create an OAuth 2.0 "Web application" Client ID at:
#   https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:4200 and your real domain.
# Put the SAME Client ID here and in frontend/src/app/site.config.ts (googleClientId).
GOOGLE_CLIENT_ID=
